# Anonymous usage totals (not visitor tracking).
#
# Mozayk stores two running counts: site visits (page loads) and visuals exported.
# No names, accounts, cookies, or file contents — visitors are not identified.
# Copy these environment variables into Vercel / GitHub Actions. Do not commit live tokens.

# ── GitHub Actions (repo → Settings → Secrets and variables → Actions) ────────
# Public variable, baked into the static site at build time (not a credential):
VITE_STATS_API_URL=https://YOUR-PROJECT.vercel.app/api/stats

# ── Vercel (Project → Settings → Environment Variables) ───────────────────────
# Counter store. Same Upstash instance as Orby is fine; keys are namespaced (mozayk:stats:…).
UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# CORS — lock the API to the public site (required in production):
MOZAYK_STATS_ALLOWED_ORIGINS=https://stellanjoh2.github.io
