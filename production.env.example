# Mozayk anonymous stats — copy to Vercel / GitHub Actions (do not commit real secrets).

# ── GitHub Actions (repo → Settings → Secrets and variables → Actions) ────────
# Variables (public — baked into the static site at build time):
VITE_STATS_API_URL=https://YOUR-PROJECT.vercel.app/api/stats

# ── Vercel (Project → Settings → Environment Variables) ───────────────────────
# Same Upstash instance as Orby is fine; keys are namespaced (mozayk:stats:…).
UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# CORS — lock the API to the public site (required in production):
MOZAYK_STATS_ALLOWED_ORIGINS=https://stellanjoh2.github.io
